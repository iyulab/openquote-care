<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AssemblyName>openquote-care-sidecar</AssemblyName>
    <RootNamespace>OpenquoteCare.Sidecar</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Published ahead-of-time compiled: a small native executable that starts fast. Building with
         this set also runs the trim and AOT analyzers, so a change that would break it fails the build. -->
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Openquote" />
    <PackageReference Include="Openquote.Gil" />
    <!-- TODO(upstream: Gil SQLite split) Gil's package brings SQLite for its on-disk stores; the sidecar keeps
         everything in memory and never opens a database, so the native library is left out of the build
         and the published executable. Remove this reference once Gil's in-memory form path ships without it. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" ExcludeAssets="all" />
    <PackageReference Include="TauriKit.Sidecar.Loopback" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenquoteCare.Tests" />
  </ItemGroup>

</Project>
