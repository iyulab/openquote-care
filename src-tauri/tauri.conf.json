{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Openquote Care",
  "version": "0.0.0",
  "identifier": "com.iyulab.openquote-care",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Openquote Care",
        "width": 1200,
        "height": 780,
        "minWidth": 720,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": { "../packs": "packs" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
