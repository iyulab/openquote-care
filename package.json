{
  "name": "openquote-care",
  "version": "0.10.1",
  "private": true,
  "description": "Counselling records that stay yours, and monthly reports that survive a change of categories",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:sidecar": "dotnet build sidecar/OpenquoteCare.Sidecar -c Release",
    "publish:sidecar": "node scripts/publish-sidecar.mjs",
    "bundle": "npm run publish:sidecar && tauri build --config src-tauri/tauri.bundle.conf.json",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:e2e": "tauri build --debug --no-bundle --config src-tauri/tauri.e2e.conf.json",
    "test:e2e": "node e2e/run.mjs",
    "test:installed": "node e2e/installed.mjs",
    "test:upgrade": "node e2e/upgrade.mjs",
    "test:update": "node e2e/update.mjs",
    "test:sandbox": "node e2e/sandbox.mjs",
    "verify": "node scripts/verify.mjs",
    "check:tokens": "desktop-compact-check-tokens --defined src/styles.css src",
    "check:core": "node scripts/check-core-neutral.mjs",
    "test:scripts": "node --test \"scripts/*.test.mjs\"",
    "notices": "tauri-kit-dev notices --config notices.config.js --strict",
    "tauri": "tauri"
  },
  "dependencies": {
    "@iyulab/desktop-compact": "^0.11.1",
    "@iyulab/desktop-patterns": "^0.8.0",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "lit": "^3.3.3",
    "pretendard": "^1.3.9"
  },
  "devDependencies": {
    "@iyulab/tauri-kit-dev": "^0.6.2",
    "@tauri-apps/cli": "^2.12.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
