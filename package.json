{
  "name": "openquote-care",
  "version": "0.1.2",
  "private": true,
  "description": "Counselling records that stay yours, and monthly reports that survive a change of categories",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:sidecar": "dotnet build sidecar/OpenquoteCare.Sidecar -c Release",
    "publish:sidecar": "node scripts/publish-sidecar.mjs",
    "bundle": "npm run publish:sidecar && tauri build --config src-tauri/tauri.bundle.conf.json",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:e2e": "tauri build --debug --no-bundle --config src-tauri/tauri.e2e.conf.json",
    "test:e2e": "node e2e/run.mjs",
    "test:installed": "node e2e/installed.mjs",
    "test:upgrade": "node e2e/upgrade.mjs",
    "test:sandbox": "node e2e/sandbox.mjs",
    "verify": "node scripts/verify.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@iyulab/desktop-compact": "0.8.1",
    "@iyulab/desktop-patterns": "0.3.4",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
